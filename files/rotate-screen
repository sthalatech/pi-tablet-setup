#!/bin/bash
# rotate-screen - rotate the touch panel (touch follows automatically).
#
#   rotate-screen            rotate 90° clockwise from where it is now
#   rotate-screen ccw        rotate 90° counter-clockwise
#   rotate-screen normal|90|180|270
#   rotate-screen status     show the current rotation
#
# The rotation is remembered (kanshi config), so it survives reboots.
set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
RC="$HOME/.config/labwc/rc.xml"
KANSHI="$HOME/.config/kanshi/config"
ORDER=(normal 90 180 270)

OUT="${ROTATE_OUTPUT:-$(wlr-randr | awk '/^DSI-/{print $1; exit}')}"
[ -n "$OUT" ] || OUT="$(wlr-randr | awk '/^[A-Z]/{print $1; exit}')"
[ -n "$OUT" ] || { echo "rotate-screen: no display found" >&2; exit 1; }

current() {
  wlr-randr | awk -v o="$OUT" '$1==o{f=1; next} /^[^ ]/{f=0} f && /Transform:/{print $2; exit}'
}

notify() {
  echo "$1"
  gdbus call --session --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify \
    "Rotate screen" 0 "display" "$1" "" "[]" "{}" 2000 >/dev/null 2>&1 || true
}

cur="$(current)"; cur="${cur:-normal}"
idx=0; for i in "${!ORDER[@]}"; do [ "${ORDER[$i]}" = "$cur" ] && idx=$i; done

case "${1:-cw}" in
  cw|next|right|"") new="${ORDER[$(( (idx + 1) % 4 ))]}" ;;
  ccw|left)         new="${ORDER[$(( (idx + 3) % 4 ))]}" ;;
  normal|0|reset)   new=normal ;;
  90|180|270)       new="$1" ;;
  status)           echo "$OUT: $cur"; exit 0 ;;
  -h|--help)        sed -n '2,10p' "$0"; exit 0 ;;
  *) echo "rotate-screen: unknown option '$1' (try --help)" >&2; exit 2 ;;
esac

wlr-randr --output "$OUT" --transform "$new"

# labwc rotates touch along with the output (touch is mapped to it in rc.xml),
# so nothing to do for touch. Drop the calibration block older versions wrote.
if [ -f "$RC" ] && grep -q '<!-- rotate-screen -->' "$RC"; then
  python3 - "$RC" <<'PY'
import re, sys
s = open(sys.argv[1]).read()
open(sys.argv[1], "w").write(re.sub(r'[ \t]*<!-- rotate-screen -->.*?<!-- /rotate-screen -->\n?', '', s, flags=re.S))
PY
  pkill -HUP -u "$(id -u)" -x labwc || true
fi

# Remember it: kanshi re-applies its profile at login and on hotplug.
if [ -f "$KANSHI" ]; then
  python3 - "$KANSHI" "$OUT" "$new" <<'PY'
import re, sys
path, out, new = sys.argv[1:]
lines = []
for ln in open(path).read().split("\n"):
    if re.match(rf'\s*output {re.escape(out)}\b', ln):
        ln = re.sub(r'\s+transform \S+', '', ln)
        if new != "normal":
            ln += f" transform {new}"
    lines.append(ln)
open(path, "w").write("\n".join(lines))
PY
fi

case "$new" in
  normal) notify "Screen rotation: normal" ;;
  *)      notify "Screen rotation: ${new}° clockwise" ;;
esac
